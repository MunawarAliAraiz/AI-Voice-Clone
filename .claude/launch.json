{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 1420
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "backend",
      "port": 8000,
      "env": { "VCS_ALLOW_FAKE_RUNTIME": "1" }
    },
    {
      "name": "listen",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8777"],
      "cwd": "eval/results/urdu_bakeoff",
      "port": 8777
    }
  ]
}
