# ---------------------------------------------------------------
# AI Voice Clone Studio — Environment Variables Template
# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# All variables are optional — defaults are shown below.
# Variables must be prefixed with VCS_ (Voice Clone Studio)
# ---------------------------------------------------------------

# -- App ----------------------------------------------------------
VCS_APP_NAME="AI Voice Clone Studio"
VCS_APP_VERSION="0.1.0"
VCS_DEBUG=false                        # Set true for hot-reload in dev

# -- Server -------------------------------------------------------
VCS_HOST=0.0.0.0                       # 0.0.0.0 = all interfaces (server); 127.0.0.1 = local only
VCS_PORT=8000

# -- Security -----------------------------------------------------
# Leave empty to disable API key auth (open access — fine for local use).
# Set a strong random value for a public-facing server.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
VCS_API_KEY=

# -- CORS ---------------------------------------------------------
# Comma-separated list of extra allowed origins (beyond localhost defaults).
# Use when your frontend is hosted on Vercel, Netlify, or a custom domain.
# Example: VCS_CORS_ORIGINS=https://myapp.vercel.app,https://myapp.com
VCS_CORS_ORIGINS=

# -- AI Engine ----------------------------------------------------
# Engine to use by default if not specified in the API request.
# Options: mock | f5_tts | fish_speech | xtts_v2
VCS_DEFAULT_ENGINE=f5_tts              # Change to mock for dev without GPU
VCS_DEFAULT_LANGUAGE=en

# -- GPU ----------------------------------------------------------
VCS_USE_GPU=true                       # Auto-fallback to CPU if no CUDA available
VCS_GPU_DEVICE=cuda:0                  # Use cuda:1 for second GPU if applicable

# -- Audio --------------------------------------------------------
VCS_DEFAULT_SAMPLE_RATE=44100
VCS_DEFAULT_OUTPUT_FORMAT=wav
VCS_MAX_RECORDING_DURATION_SEC=300     # Max 5 minutes per recording
VCS_MAX_UPLOAD_SIZE_MB=50
