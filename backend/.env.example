# ---------------------------------------------------------------
# AI Voice Clone Studio — Environment Variables
# ---------------------------------------------------------------
# Copy to .env and set values. All optional except where marked.
# ---------------------------------------------------------------

# -- Runtime Python Interpreters (REQUIRED for generation) -------
# Absolute path to each runtime's venv python. Empty = that runtime is unrunnable.
# Built by pod-bootstrap.sh as /workspace/AI-Voice-Clone/backend/.venv-voxcpm
VCS_VOXCPM_PYTHON=
VCS_CHATTERBOX_PYTHON=
VCS_F5_PYTHON=

# Working directory for worker processes (must contain importable 'app' package).
# Default: current directory
VCS_WORKER_CWD=

# -- Security -----------------------------------------------------
# API key for X-API-Key header authentication. Empty = open access (local dev only).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
VCS_API_KEY=

# -- CORS (JSON array) --------------------------------------------
# JSON array of allowed origins. Default: ["http://localhost:1420", "http://127.0.0.1:1420", "http://localhost:5173", "http://127.0.0.1:5173"]
# Production example: VCS_CORS_ORIGINS='["https://studio-abc123.pages.dev","https://my-domain.com"]'
# NOTE: ["*"] together with VCS_API_KEY is REFUSED at boot — list exact origins.
VCS_CORS_ORIGINS=

# -- Media Token Secret -------------------------------------------
# HMAC secret for signed media URLs. Auto-generated per process if unset.
# REQUIRED in production — without it, every restart invalidates in-flight audio URLs.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
VCS_MEDIA_TOKEN_SECRET=

# Media token TTL in seconds. Default: 3600 (1 hour)
VCS_MEDIA_TOKEN_TTL_SEC=3600

# -- Storage ------------------------------------------------------
# Root directory for voices, generations, database. Default: ./data
VCS_DATA_DIR=data

# -- Scheduler (defaults suit 24GB GPU) ---------------------------
VCS_BUDGET_MB=16000
VCS_MAX_WORKERS=2

# -- Upload Limit -------------------------------------------------
VCS_MAX_UPLOAD_MB=50

# -- Testing Only -------------------------------------------------
# Enables the fake silence runtime (X-Fake-Audio: true header). Default: false
VCS_ALLOW_FAKE_RUNTIME=false
